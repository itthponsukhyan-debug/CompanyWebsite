@{
    ViewData["Title"] = "หน้าแรก";
}

<!-- HERO SECTION -->
<section class="hero" id="home">
    <div class="hero-content">
        <span class="eyebrow">YOUR TRUSTED BUSINESS PARTNER</span>
        <h1>ขับเคลื่อนธุรกิจ<br>สู่อนาคตที่ดีกว่า</h1>
        <p>
            เรามุ่งมั่นส่งมอบผลิตภัณฑ์และบริการที่มีคุณภาพ
            พร้อมสร้างความเชื่อมั่นและเติบโตไปกับลูกค้าของเรา
        </p>
        <div class="hero-buttons">
            <a href="#products" class="btn-main">ดูสินค้า</a>
       
        </div>
    </div>

    <div class="hero-image">
        <!-- เปลี่ยน URL ด้านล่างเป็นลิงก์รูปบริษัทของคุณ -->
        <img src="https://lh3.googleusercontent.com/5AuaJ1EmdAf_2puxJ71rI3AGsRKLt7ygGCrd_KtVXYvIe7UeLUlRdWmv3EaeFJL3Fx0Gqqf0ftyTWCBr=w2116"
             alt="สำนักงานบริษัท">
    </div>
</section>



<!-- ABOUT SECTION -->
<section class="section about" id="about">
    <div class="section-image">
        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTOMJAMCP6EhPcnuuXcdf5rYi2QUMKf6EqDu23d_v99fqSr0pY--Y3UK3dY&s=10"
             alt="ทีมงานบริษัท">
    </div>

    <div class="section-content">
        <span class="eyebrow">ABOUT OUR COMPANY</span>
        <h2>เกี่ยวกับบริษัทของเรา</h2>
        <p>
            เราเป็นองค์กรที่ให้ความสำคัญกับคุณภาพ
            นวัตกรรม และความพึงพอใจของลูกค้า
            พร้อมพัฒนาผลิตภัณฑ์และบริการให้ตอบโจทย์ธุรกิจ
        </p>
        <a href="#contact" class="text-link">ร่วมงานกับเรา →</a>
    </div>
</section>

<!-- PRODUCTS SECTION -->
<section class="section products" id="products">
    <div class="section-heading">
        <span class="eyebrow">OUR PRODUCTS</span>
        <h2>สินค้าและบริการของเรา</h2>
        <p>คัดสรรคุณภาพเพื่อรองรับทุกความต้องการของธุรกิจ</p>
    </div>

    <div class="product-grid">
        <article class="product-card">
            <!-- เปลี่ยน URL นี้เป็นรูปสินค้าชิ้นที่ 1 -->
            <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQpSgD_xSf6Q2WTBNbaxRl_GDjEpzV4rm_yon7NvReaT0EGPgqCWoBd2b8&s=10"
                 alt="ทรายหยาบ">
            <div class="product-info">
                <span class="product-label">PRODUCT 01</span>
                <h3>ทรายหยาบ</h3>
                <p>
                    ทรายหยาบเกรดเอ คัดสะอาด เม็ดใหญ่ คม แข็งแรง เหมาะสำหรับงานโครงสร้างทุกประเภท ไม่ว่าจะเป็นงานเทพื้นคอนกรีต งานก่ออิฐ หรืองานหล่อคาน มั่นใจได้ในความแข็งแรง ได้มาตรฐาน ผสมปูนแล้วเกาะตัวดีเยี่ยม
                    บริการของเรา:
                    มีรถบริการจัดส่งถึงที่ 
                </p>
                <a href="#contact" class="text-link">สอบถามเพิ่มเติม →</a>
            </div>
        </article>

        <article class="product-card">
            <!-- เปลี่ยน URL นี้เป็นรูปสินค้าชิ้นที่ 2 -->
            <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRjLnpuPtZyCXsuOO648ucstE5jxELLS5ZVKUaNRvBflA&s=10"
                 alt="หินสแลค 2">
            <div class="product-info">
                <span class="product-label">PRODUCT 02</span>
                <h3>หินสแลค</h3>
                <p>
                    วัสดุมวลรวมคุณภาพสูงจากกระบวนการผลิตอุตสาหกรรม ผ่านการคัดสรรเพื่อใช้ทดแทนหินธรรมชาติในงานวิศวกรรมโยธาและงานฐานรากทั่วไป
                    มีความแข็งแรงสูง ทนทานต่อแรงบดอัดและการขัดสี
                    เหมาะสำหรับงานปรับปรุงชั้นพื้นทาง ทำถนน ลานจอดรถ เทพื้นโรงงาน หรือถมบริเวณที่มีปัญหาน้ำขังและดินอ่อน
                </p>
                <a href="#contact" class="text-link">สอบถามเพิ่มเติม →</a>
            </div>
        </article>

        <article class="product-card">
            <!-- เปลี่ยน URL นี้เป็นรูปสินค้าชิ้นที่ 3 -->
            <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSK30hxIxuht4FVEPnGUGXISFbHA-u2FgGgtCU92T2Xfg&s=10"
                 alt="คอนกรีตผสมเสร็จ">
            <div class="product-info">
                <span class="product-label">PRODUCT 03</span>
                <h3>คอนกรีตผสมเสร็จ</h3>
                <p>
                    คอนกรีตผสมเสร็จ คุณภาพสูง ส่งไว ทันใช้ทุกหน้างาน!
                    ควบคุมคุณภาพตามมาตรฐาน มอก.
                   มีทีมรถโม่ให้บริการรอบพื้นที่
                </p>
                <a href="#contact" class="text-link">สอบถามเพิ่มเติม →</a>
            </div>
        </article>
        
    </div>
</section>

